# انسخ الملف ده وسميه .env.local ثم عدل القيم

# اسم مستخدم الأدمن
ADMIN_USERNAME=admin

# هاش الباسورد (شغل: node scripts/hash-password.js "الباسورد بتاعك")
# السكريبت بيطبعلك القيمة جاهزة بعلامات \$ بدل $ عشان Next.js
# متفهمش $ في الملف على إنها متغير - انسخ القيمة زي ما هي من غير تعديل
ADMIN_PASSWORD_HASH=

# مفتاح سري لتوقيع جلسة تسجيل الدخول (اكتب أي نص عشوائي طويل)
JWT_SECRET=change-this-to-a-long-random-secret
